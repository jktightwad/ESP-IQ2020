# Copy this file to secrets.yaml (in the same folder as your ESPHome
# config) and fill in real values. secrets.yaml should never be committed.

wifi_ssid: "YourWiFiName"
wifi_password: "YourWiFiPassword"

# Password for the fallback access point the ESP32 creates if it can't
# reach your WiFi. Must be at least 8 characters.
fallback_ap_password: "changeme123"

# Used for over-the-air firmware updates (esphome run / esphome upload).
ota_password: "changeme-ota-password"

# Basic auth for the standalone web control page (web_server).
web_username: "admin"
web_password: "changeme-web-password"
